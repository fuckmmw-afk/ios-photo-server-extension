diff --git a/internal/modules/openai/image_input.go b/internal/modules/openai/image_input.go
new file mode 100644
index 0000000..33573e4
--- /dev/null
+++ b/internal/modules/openai/image_input.go
@@ -0,0 +1,49 @@
+package openai
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"gemini-web-to-api/internal/commons/models"
+	"gemini-web-to-api/internal/modules/providers"
+	"image"
+	_ "image/jpeg"
+	_ "image/png"
+	"strings"
+)
+
+const maxImageBytes = 25 * 1024 * 1024
+
+func imageInputFiles(value string) ([]providers.InputFile, error) {
+	if value == "" {
+		return nil, nil
+	}
+	header, encoded, ok := strings.Cut(value, ",")
+	types := map[string]string{"data:image/jpeg;base64": "image/jpeg", "data:image/png;base64": "image/png", "data:image/heic;base64": "image/heic", "data:image/heif;base64": "image/heif"}
+	mime, supported := types[header]
+	if !ok || !supported {
+		return nil, fmt.Errorf("invalid image: expected JPEG, PNG, HEIC or HEIF base64 data URL")
+	}
+	if len(encoded) > base64.StdEncoding.EncodedLen(maxImageBytes) {
+		return nil, fmt.Errorf("invalid image: exceeds 25 MiB")
+	}
+	data, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil || len(data) == 0 || len(data) > maxImageBytes {
+		return nil, fmt.Errorf("invalid image: corrupt base64 or size exceeds 25 MiB")
+	}
+	if mime == "image/jpeg" || mime == "image/png" {
+		config, format, err := image.DecodeConfig(bytes.NewReader(data))
+		if err != nil || "image/"+format != mime || config.Width <= 0 || config.Height <= 0 {
+			return nil, fmt.Errorf("invalid image: MIME does not match image content")
+		}
+	} else {
+		if len(data) < 16 || string(data[4:8]) != "ftyp" {
+			return nil, fmt.Errorf("invalid image: missing HEIF container header")
+		}
+		brand := string(data[8:12])
+		if !strings.Contains("heic heix hevc hevx mif1 msf1", brand) {
+			return nil, fmt.Errorf("invalid image: unsupported HEIF brand")
+		}
+	}
+	return providers.InputFilesFromAttachmentList([]models.Attachment{{Name: "source." + strings.TrimPrefix(mime, "image/"), MimeType: mime, Data: encoded}})
+}
diff --git a/internal/modules/openai/image_input_test.go b/internal/modules/openai/image_input_test.go
new file mode 100644
index 0000000..c316749
--- /dev/null
+++ b/internal/modules/openai/image_input_test.go
@@ -0,0 +1,29 @@
+package openai
+
+import (
+	"bytes"
+	"encoding/base64"
+	"image"
+	"image/png"
+	"testing"
+)
+
+func TestImageInputFiles(t *testing.T) {
+	var b bytes.Buffer
+	if err := png.Encode(&b, image.NewRGBA(image.Rect(0, 0, 3, 2))); err != nil {
+		t.Fatal(err)
+	}
+	encoded := base64.StdEncoding.EncodeToString(b.Bytes())
+	files, err := imageInputFiles("data:image/png;base64," + encoded)
+	if err != nil || len(files) != 1 {
+		t.Fatalf("valid image: %v", err)
+	}
+	for _, value := range []string{"https://example.org/image.png", "data:image/png;base64,garbage", "data:image/jpeg;base64," + encoded, "data:image/heic;base64," + encoded} {
+		if _, err := imageInputFiles(value); err == nil {
+			t.Fatalf("accepted invalid input %q", value[:20])
+		}
+	}
+	if files, err := imageInputFiles(""); err != nil || len(files) != 0 {
+		t.Fatal("text-to-image compatibility broken")
+	}
+}

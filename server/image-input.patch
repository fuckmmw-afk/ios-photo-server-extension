@@ -0,0 +1,37 @@
+package openai
+
+import (
+	"bytes"
+	"encoding/base64"
+	"image"
+	"image/png"
+	"strings"
+	"testing"
+)
+
+func TestImageInputFiles(t *testing.T) {
+	var b bytes.Buffer
+	if err := png.Encode(&b, image.NewRGBA(image.Rect(0, 0, 3, 2))); err != nil {
+		t.Fatal(err)
+	}
+	encoded := base64.StdEncoding.EncodeToString(b.Bytes())
+	files, err := imageInputFiles("data:image/png;base64," + encoded)
+	if err != nil || len(files) != 1 {
+		t.Fatalf("valid image: %v", err)
+	}
+	for _, value := range []string{"https://example.org/image.png", "data:image/png;base64,garbage", "data:image/jpeg;base64," + encoded, "data:image/heic;base64," + encoded} {
+		if _, err := imageInputFiles(value); err == nil {
+			t.Fatalf("accepted invalid input %q", value[:20])
+		}
+	}
+	if files, err := imageInputFiles(""); err != nil || len(files) != 0 {
+		t.Fatal("text-to-image compatibility broken")
+	}
+}
+
+func TestImageEditPromptUsesAttachmentAndOrientation(t *testing.T) {
+	prompt := buildImageGenerationPrompt("make it warmer", "", true, 6)
+	if !strings.Contains(prompt, "Edit the attached image") || !strings.Contains(prompt, "orientation 6") {
+		t.Fatalf("image edit prompt lost attachment context: %q", prompt)
+	}
+}

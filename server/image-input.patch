diff --git a/internal/server/server_auth_test.go b/internal/server/server_auth_test.go
new file mode 100644
index 0000000..c44678d
--- /dev/null
+++ b/internal/server/server_auth_test.go
@@ -0,0 +1,33 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"gemini-web-to-api/internal/commons/configs"
+	"go.uber.org/zap"
+)
+
+func TestPhotoServerAPIKeyMiddleware(t *testing.T) {
+	app := NewGeminiWebToAPI(zap.NewNop(), &configs.Config{Server: configs.ServerConfig{APIKey: "test-key-with-sufficient-entropy"}})
+
+	unauthenticated := httptest.NewRequest(http.MethodGet, "/health", nil)
+	response, err := app.Test(unauthenticated)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode != http.StatusUnauthorized {
+		t.Fatalf("unauthenticated status = %d, want %d", response.StatusCode, http.StatusUnauthorized)
+	}
+
+	authenticated := httptest.NewRequest(http.MethodGet, "/health", nil)
+	authenticated.Header.Set("X-PhotoServer-Key", "test-key-with-sufficient-entropy")
+	response, err = app.Test(authenticated)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode != http.StatusOK {
+		t.Fatalf("authenticated status = %d, want %d", response.StatusCode, http.StatusOK)
+	}
+}

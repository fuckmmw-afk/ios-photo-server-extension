+++ b/internal/modules/openai/image_input.go
@@ -0,0 +1,49 @@
+package openai
+
+import (
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"gemini-web-to-api/internal/modules/providers"
+	"image"
+	_ "image/jpeg"
+	_ "image/png"
+	"strings"
+)
+
+const maxImageBytes = 25 * 1024 * 1024
+
+func imageInputFiles(value string) ([]providers.InputFile, error) {
+	if value == "" {
+		return nil, nil
+	}
+	header, encoded, ok := strings.Cut(value, ",")
+	types := map[string]string{"data:image/jpeg;base64": "image/jpeg", "data:image/png;base64": "image/png", "data:image/heic;base64": "image/heic", "data:image/heif;base64": "image/heif"}
+	mime, supported := types[header]
+	if !ok || !supported {
+		return nil, fmt.Errorf("invalid image: expected JPEG, PNG, HEIC or HEIF base64 data URL")
+	}
+	if len(encoded) > base64.StdEncoding.EncodedLen(maxImageBytes) {
+		return nil, fmt.Errorf("invalid image: exceeds 25 MiB")
+	}
+	data, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil || len(data) == 0 || len(data) > maxImageBytes {
+		return nil, fmt.Errorf("invalid image: corrupt base64 or size exceeds 25 MiB")
+	}
+	if mime == "image/jpeg" || mime == "image/png" {
+		config, format, err := image.DecodeConfig(bytes.NewReader(data))
+		if err != nil || "image/"+format != mime || config.Width <= 0 || config.Height <= 0 {
+			return nil, fmt.Errorf("invalid image: MIME does not match image content")
+		}
+	} else {
+		if len(data) < 16 || string(data[4:8]) != "ftyp" {
+			return nil, fmt.Errorf("invalid image: missing HEIF container header")
+		}
+		brand := string(data[8:12])
+		supportedBrands := map[string]struct{}{"heic": {}, "heix": {}, "hevc": {}, "hevx": {}, "heis": {}, "hevm": {}, "hevs": {}, "mif1": {}, "msf1": {}}
+		if _, ok := supportedBrands[brand]; !ok {
+			return nil, fmt.Errorf("invalid image: unsupported HEIF brand")
+		}
+	}
+	return []providers.InputFile{{Name: "source." + strings.TrimPrefix(mime, "image/"), MimeType: mime, Data: data}}, nil
+}
